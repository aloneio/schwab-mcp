{
  "name": "schwab-mcp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "inspect": "npx @modelcontextprotocol/inspector@latest",
    "format": "prettier . --write",
    "lint": "eslint .",
    "typecheck": "tsc",
    "validate": "npm run typecheck && npm run lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx --test tests/browser-auth.ts",
    "test:integration": "wrangler deploy --dry-run --config wrangler.example.jsonc --outdir .wrangler/integration && node --import tsx --test tests/worker-integration.ts",
    "build": "wrangler deploy --dry-run --config wrangler.example.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@epic-web/config": "^1.21.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sudowealth/schwab-api": "^2.1.0",
    "hono": "^4.13.13",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "prettier": "@epic-web/config/prettier",
  "author": "Daniel Yeoman",
  "license": "MIT"
}
